{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MiAgendaApp",
  "version": "0.1.0",
  "identifier": "com.cristian.miagendaap",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MiAgendaApp",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Cristian Luque Domínguez",
    "copyright": "© 2026 Cristian Luque Domínguez",
    "category": "Productivity",
    "shortDescription": "Agenda y editor de notas de escritorio, 100 % local.",
    "longDescription": "MiAgendaApp reúne tareas, recordatorios, calendario y notas en una sola aplicación de escritorio. Todos los datos se guardan en tu equipo: sin cuentas, sin telemetría y sin conexión a internet.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "es-ES"
      }
    }
  }
}
